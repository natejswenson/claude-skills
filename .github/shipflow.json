{
  "branches": {
    "main": "main"
  },
  "featureBranchPrefix": "feature/",
  "requiredChecks": [
    "ci / appletv",
    "ci / brandreport",
    "ci / city-report",
    "ci / devlog",
    "ci / eval",
    "ci / ghfactory",
    "ci / ghostwriter",
    "ci / ghostwriter-x",
    "ci / github-stats",
    "ci / gmailtriage",
    "ci / issuecreator",
    "ci / issueflow",
    "ci / netwatch",
    "ci / pluginsync",
    "ci / press",
    "ci / release",
    "ci / resume",
    "ci / shipflow",
    "ci / shipreport",
    "ci / skillfactory",
    "ci / skillhelp"
  ],
  "mergeMethod": {
    "devToMainMethod": "squash"
  },
  "protectionOwner": "external",
  "release": {
    "enabled": true,
    "mode": "manual-gate",
    "tool": "release-please",
    "layout": "manifest",
    "releaseCredential": "SHIPFLOW_AUTOMERGE_PAT",
    "componentLayout": {
      "versionFiles": [
        "skills/{name}/skills/{name}/package.json",
        "skills/{name}/skills/{name}/SKILL.md",
        "skills/{name}/.claude-plugin/plugin.json",
        "skills/{name}/skills/{name}/package-lock.json",
        "skills/{name}/.codex-plugin/plugin.json"
      ],
      "changelog": "skills/{name}/CHANGELOG.md",
      "tagPattern": "{name}-v{version}",
      "paths": [
        "skills/{name}"
      ],
      "workflowFile": "{name}.yml"
    },
    "components": [
      "appletv",
      "brandreport",
      "city-report",
      "devlog",
      "eval",
      "ghfactory",
      "ghostwriter",
      "ghostwriter-x",
      "github-stats",
      "gmailtriage",
      "issuecreator",
      "issueflow",
      "netwatch",
      "pluginsync",
      "press",
      "release",
      "resume",
      "shipflow",
      "shipreport",
      "skillfactory",
      "skillhelp"
    ]
  },
  "branchCleanup": {
    "deleteOnMerge": true,
    "protectedBranches": [
      "main"
    ]
  },
  "enforceAdmins": false,
  "renderedTemplateHashes": {
    ".github/workflows/main-automerge.yml": "c3d9150170792d69390ad4816e83b1a4e7340da55369816b3fa77c6ebc287174"
  },
  "workflowPattern": "github-flow"
}
