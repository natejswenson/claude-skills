# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
#
# Publishing goes through the Typefully API (free plan: 1 social set,
# ~15 posts/month) — X's own API has no free tier anymore.
#
# 1. Sign up at https://typefully.com and connect your X account.
# 2. Settings -> API -> create a key, paste it here:
TYPEFULLY_API_KEY=your_api_key_here

# --- Filled in automatically by `typefully_post.py --connect` (do not edit) ---
TYPEFULLY_SOCIAL_SET_ID=
