# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
#
# From your X developer app (https://developer.x.com/en/portal/dashboard),
# User authentication settings — OAuth 2.0:
X_CLIENT_ID=your_client_id_here
# Leave blank for a public client (app type "Native App"). Set it only if your
# app is a confidential "Web App" client.
X_CLIENT_SECRET=

# Must EXACTLY match a "Callback URI / Redirect URL" you added in the app's
# auth settings. The default below is what scripts/x_auth.py listens on.
# (Port 8766 — deliberately distinct from the LinkedIn ghostwriter's 8765.)
X_REDIRECT_URI=http://localhost:8766/callback

# --- Filled in automatically by scripts/x_auth.py (do not edit by hand) ---
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_REFRESH_TOKEN_PREV=
X_TOKEN_EXPIRES_AT=
X_USER_ID=
X_USERNAME=
