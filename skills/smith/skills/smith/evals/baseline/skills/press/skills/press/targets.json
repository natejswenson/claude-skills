{
  "$comment": "Fixture house — the press registry a scaffold run has to append its two brand targets to.",
  "targets": [
    {
      "id": "press-readme",
      "repo": "claude-skills",
      "path": "skills/press/README.md",
      "region": "version",
      "syntax": "md",
      "emitter": "version-badge",
      "params": {
        "what": "The brand"
      }
    },
    {
      "id": "tally-agent-ui",
      "repo": "claude-skills",
      "path": "skills/tally/skills/tally/SKILL.md",
      "region": "agent-ui",
      "syntax": "md",
      "emitter": "markdown-block",
      "params": {
        "doc": "agent-ui"
      }
    },
    {
      "id": "tally-readme",
      "repo": "claude-skills",
      "path": "skills/tally/README.md",
      "region": "version",
      "syntax": "md",
      "emitter": "version-badge",
      "params": {
        "what": "The brand regions"
      },
      "init": {
        "insertAfter": "^# tally "
      }
    }
  ]
}
