{
  "name": "@natjswenson/brand-images",
  "version": "0.1.0",
  "description": "Generate images in a user’s consistent brand style and refine that style through explicit feedback.",
  "license": "MIT",
  "author": "Nate Swenson",
  "homepage": "https://github.com/natejswenson/claude-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natejswenson/claude-skills.git"
  },
  "bugs": {
    "url": "https://github.com/natejswenson/claude-skills/issues"
  },
  "keywords": [
    "brand-images",
    "claude-code",
    "claude-skill"
  ],
  "type": "module",
  "bin": {
    "brand-images": "scripts/brand-images.js"
  },
  "files": [
    "scripts/",
    "references/",
    "skill-invariants.json",
    "SKILL.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "audit": "npm audit --audit-level=moderate",
    "prepack": "cp ../../README.md ../../LICENSE ../../CHANGELOG.md .",
    "postpack": "rm -f README.md LICENSE CHANGELOG.md"
  }
}
