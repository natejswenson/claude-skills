  "bin": {
    "press": "bin/press.js"
  },
  "files": [
    "bin/",
    "lib/",
    "brand/",
    "targets.json",
    "skill-invariants.json",
    "SKILL.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "audit": "npm audit --audit-level=moderate",
