{
  "name": "@natjswenson/press",
  "version": "0.3.0",
  "description": "One brand system — tokens, laws, run presentation and voice core — generated into every consumer with a CI drift gate",
  "license": "MIT",
  "author": "Nate Swenson",
  "homepage": "https://github.com/natejswenson/claude-skills",
  "repository": {
    "type": "git",
