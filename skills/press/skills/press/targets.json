          {
            "token": "rule",
            "comment": "heavy editorial rules"
          },
          {
            "token": "serif_stack",
            "name": "serif",
            "comment": "commentary voice"
          },
          {
            "token": "stamp",
            "quote": true,
            "comment": "your monogram initials (2 chars)"
          },
          {
            "token": "term_bg",
            "comment": "dark panel: only ever inside .term"
          },
          {
            "token": "term_text"
          },
          {
            "token": "term_dim"
          },
          {
            "token": "term_hot"
          },
          {
            "token": "term_prompt"
          }
        ],
        "trailing": [
          "color: var(--ink);"
        ],
        "comments": "explicit",
        "align": true
      },
      "init": {
        "replaceFrom": "^\\.card\\.press \\{$",
        "replaceTo": "^\\}$"
