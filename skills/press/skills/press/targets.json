          {
            "token": "paper"
          },
          {
            "token": "ink"
          },
          {
            "token": "dim"
          },
          {
            "token": "accent",
            "name": "sig"
          },
          {
            "token": "hair"
          },
          {
            "token": "display_stack",
            "name": "font"
          },
          {
            "token": "serif_stack",
            "name": "serif"
          },
