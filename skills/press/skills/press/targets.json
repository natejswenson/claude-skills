        "document_kind": "MORNING BRIEF",
        "logging": true,
        "extras": [
          "mono_file"
        ]
      },
      "init": {
        "replaceFrom": "^import copy$",
        "replaceTo": "^    return theme$"
      }
    },
    {
      "id": "site-tokens",
      "repo": "natejswenson.io",
      "path": "src/styles/global.css",
      "region": "tokens",
      "syntax": "css",
      "emitter": "css-vars",
      "params": {
        "selector": ":root",
        "align": true,
        "comments": false,
        "vars": [
          {
            "token": "paper",
            "name": "bg"
          },
          {
            "token": "paper_surface",
            "name": "bg-surface"
          },
          {
            "token": "paper_elevated",
            "name": "bg-elevated"
          },
          {
            "token": "ink",
            "name": "fg"
          },
          {
            "token": "dim",
            "name": "fg-secondary"
          },
          {
            "token": "ink_faint",
            "name": "fg-tertiary"
          },
          {
            "token": "accent"
          },
          {
            "token": "rule"
          },
          {
            "token": "term_bg",
            "name": "panel"
          },
          {
            "token": "term_text",
            "name": "panel-fg"
          },
          {
            "token": "term_dim",
            "name": "panel-dim"
          },
          {
            "token": "term_hot",
            "name": "panel-hot"
          },
          {
            "token": "term_prompt",
            "name": "panel-bar"
          }
        ]
      }
    }
  ]
}
