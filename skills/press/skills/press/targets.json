{
  "$comment": "Every place the brand is written down. A consumer not listed here is invisible to `press check`, which is the whole failure mode this skill exists to close \u2014 so adding a consumer means adding it here, not copying tokens into it. Paths are relative to their own repo root; selection is by file presence, so this one registry works unchanged inside claude-skills, budget, local-fitness or the site.",
  "targets": [
    {
      "id": "city-report",
      "repo": "claude-skills",
      "path": "skills/city-report/skills/city-report/scripts/brand.py",
      "region": "tokens",
      "syntax": "python",
      "emitter": "python-theme",
      "params": {
        "env_var": "CITY_REPORT_BRAND_FILE",
        "brand_line": "DATA USA",
        "byline": "datausa.io \u00b7 US Census ACS",
        "document_kind": "CITY PROFILE",
        "extras": [
          "fill_steps"
        ]
      },
      "init": {
        "replaceFrom": "^import copy$",
        "replaceTo": "^    return theme$"
      }
    },
