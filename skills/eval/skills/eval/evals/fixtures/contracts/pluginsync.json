      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 151
      }
    },
    {
      "id": "press-8f262e00",
      "tag": "press",
      "text": "Announce the skill once, at the start",
      "severity": "medium",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 175
      }
    },
    {
      "id": "press-932da062",
      "tag": "press",
      "text": "Keep the machinery invisible.",
      "severity": "medium",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 148
      }
    },
    {
      "id": "press-c24d0465",
      "tag": "press",
      "text": "Show, don't describe.",
      "severity": "medium",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 165
      }
    },
    {
      "id": "rule-26bc1cbe",
      "tag": "rule",
      "text": "Never say a plugin is updated because a command succeeded.",
      "severity": "critical",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 36
      }
    },
    {
      "id": "rule-791b3480",
      "tag": "rule",
      "text": "A plugin is not refreshed until the new version is read back off disk, and it is not live until Claude Code restarts — report those as three different states and never collapse them into one.",
      "severity": "critical",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 20
      }
    },
    {
      "id": "skill-0838d62a",
      "tag": "skill",
      "text": "An unreadable source is an error row, never a dropped one.",
      "severity": "high",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 121
      }
    },
    {
      "id": "skill-19dea7cf",
      "tag": "skill",
      "text": "Never ask about anything in it",
      "severity": "high",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 65
      }
    },
    {
      "id": "skill-86ad48e8",
      "tag": "skill",
      "text": "Never report a stalled row as updated.",
      "severity": "high",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 118
      }
    },
    {
      "id": "skill-9166f695",
      "tag": "skill",
      "text": "Never claim a result you did not observe.",
      "severity": "high",
      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 116
      }
    },
    {
      "id": "skill-bfb1b27b",
      "tag": "skill",
      "text": "Announce at start:",
