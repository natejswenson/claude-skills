      "source": {
        "file": "skills/pluginsync/skills/pluginsync/SKILL.md",
        "line": 13
      }
    },
    {
      "id": "skill-c6e55217",
      "tag": "skill",
      "text": "Never uninstall an orphan without being asked.",
