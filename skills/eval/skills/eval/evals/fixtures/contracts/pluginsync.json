    },
    {
      "id": "house-59ab724c",
      "tag": "house",
      "text": "Keep this file current in the same PR.",
      "severity": "high",
      "source": {
        "file": "CLAUDE.md",
        "line": 32
      }
    },
    {
      "id": "house-6e18e8e6",
      "tag": "house",
      "text": "A merge never cuts a tag. `/release` does.",
      "severity": "high",
      "source": {
        "file": "CLAUDE.md",
        "line": 17
      }
    },
    {
      "id": "house-75b5d28b",
      "tag": "house",
      "text": "Never push directly to `main`.",
