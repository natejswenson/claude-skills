    {
      "id": "inv-e9928ba7",
      "tag": "inv",
      "text": "Every state change is checkpointed",
      "severity": "high",
      "rationale": "The run's whole record — four subagents' worth of investigation, design, implementation and proof — lives outside the target repo and outside git. Until 0.2.0 none of it reached GitHub before `ship`, which on the measured run never ran: 23 minutes of opus and sonnet output existed only as untracked files under $HOME and one unpushed commit. A gated pipeline that cannot survive losing the machine is a pipeline whose gates were the only thing it delivered.",
      "source": {
        "file": "skills/issueflow/skills/issueflow/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "press-13f05150",
      "tag": "press",
      "text": "One script call, not a pipeline.",
      "severity": "medium",
      "source": {
        "file": "skills/issueflow/skills/issueflow/SKILL.md",
        "line": 277
      }
    },
    {
      "id": "press-2485e417",
