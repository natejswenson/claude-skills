        "line": 269
      }
    },
    {
      "id": "press-c24d0465",
      "tag": "press",
      "text": "Show, don't describe.",
      "severity": "medium",
      "source": {
        "file": "skills/issueflow/skills/issueflow/SKILL.md",
        "line": 286
      }
    },
    {
      "id": "rule-95d3a758",
      "tag": "rule",
      "text": "No stage runs on anything but its predecessor's artifact, approved by the user and written to disk — and a stage that was skipped is reported as skipped, never as done.",
      "severity": "critical",
      "source": {
        "file": "skills/issueflow/skills/issueflow/SKILL.md",
        "line": 21
      }
    },
    {
      "id": "skill-19dea7cf",
      "tag": "skill",
      "text": "Never ask about anything in it",
