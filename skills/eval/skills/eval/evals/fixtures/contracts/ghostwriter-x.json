    {
      "id": "inv-0f1192db",
      "tag": "inv",
      "text": "post_outcome\\.py",
      "severity": "high",
      "rationale": "The publish log + self-reported outcomes are the ONLY compliant performance signal (free-tier read access is nil; scraping banned). Dropping the check-in reference severs the skill's feedback loop and reverts topic/format choice to blind priors.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-17bffcf2",
      "tag": "inv",
      "text": "verify_sources\\.py",
      "severity": "high",
      "rationale": "SKILL.md must reference the source gate at all (the literal appears in the Generate research step, the Publish gate note, and Guardrails). The HARD enforcement that publishing runs the gate is code-tested in tests/test_typefully_post.py (enforce_source_gate) — not this regex.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-1c3e1deb",
      "tag": "inv",
      "text": "(never add|no) (fully autonomous|unattended|scheduled)[^.\\n]posting|decline and explain",
      "severity": "high",
      "rationale": "X permits API posting, but unattended/scheduled/bulk posting is this skill's hard product line (and drifts into X's automation-labeling and spam rules). This is the only instruction telling the agent to decline it.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-242b83b3",
      "tag": "inv",
      "text": "(never put sources[\\s\\S]{0,60}?post\\s+body|sources stay in the sidecar)",
      "severity": "high",
      "rationale": "verify_sources never inspects the post body; keeping sources out of the body is prose-only (and links in tweet 1 also crush reach).",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-3860846e",
      "tag": "inv",
      "text": "voice-notes\\.md[^.]{0,80}same turn,?\\sbefore redrafting",
      "severity": "high",
      "rationale": "In-session voice corrections were lost twice in one real ghostwriter session (the user had to repeat the no-AI-closings rule). Persist-before-redraft lives only in this prose; deleting it regresses to corrections evaporating at session end.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-462a78ea",
      "tag": "inv",
      "text": "after .{0,40}save.{0,200}before .{0,40}show",
      "severity": "high",
      "rationale": "Generate flow ordering is load-bearing: research must run AFTER Save (the slug/sidecar path exists) and BEFORE Show (the shown draft is already source-backed).",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-5567449b",
      "tag": "inv",
      "text": "stops? on the\\s+last real point",
      "severity": "high",
      "rationale": "AI-sounding endings are the user's #1, most-repeated content complaint across sessions. The pre-show ending check is prose-only; the voice_judge eval samples it but nothing else forces it at draft time.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-5ede5898",
      "tag": "inv",
      "text": "never render a form\\s+the user\\s+didn.t\\s+choose",
      "severity": "high",
      "rationale": "Rendering a visual before asking wasted a full card build in a real ghostwriter session (user wanted a different form). One form question before any authoring is prose-only.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-5f8d1dbf",
      "tag": "inv",
      "text": "never\\s+(auto-?publish|publish[^.\\n]without[^.\\n]approval)",
      "severity": "high",
      "rationale": "typefully_post.py has NO approval check in code; approval-before-publish lives only in this prose. Deleting it lets the agent post to the user's real X account without consent.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-841a7c56",
      "tag": "inv",
      "text": "check-in and the menu ride in the same single",
      "severity": "high",
      "rationale": "Session-start round trips are the UX tax paid every single run: the outcome check-in and the idea menu ride in ONE AskUserQuestion dialog. This rule is prose-only; deleting it regresses to two sequential question dialogs before any work starts.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-8baca375",
      "tag": "inv",
      "text": "(allow-unverified[^.\\n]human-only|agent must never (set|self-apply) it)",
      "severity": "high",
      "rationale": "--allow-unverified is the single bypass of the source gate; it is enforced only by this human-only convention.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-90f94bb1",
      "tag": "inv",
      "text": "first tweet[^.\\n](stand alone|hook)[\\s\\S]{0,2500}?\\[\\sn\\s/\\sN\\s·",
      "severity": "high",
      "rationale": "X has no fold: tweet 1 IS the hook, and the numbered per-tweet preview with live weighted counts is the only place the user SEES each tweet's length and the hook standing alone before approving. Prose-only; deleting it regresses to showing drafts as one blob.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-a308d40c",
      "tag": "inv",
      "text": "transcription of a real session,\\snot an\\sinvention",
      "severity": "high",
      "rationale": "A real ghostwriter session (2026-07-18) burned ~9 review rounds because the terminal card was invented instead of transcribed from the agent's actual output. Capture-before-author lives only in this prose; the term-misaligned lint checks alignment, not provenance.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
    {
      "id": "inv-af121879",
      "tag": "inv",
      "text": "280\\s+weighted|weighted[^.\\n]{0,40}280",
      "severity": "high",
      "rationale": "The weighted 280/tweet limit is enforced by x_len.py at publish, but drafting to fit (URLs=23, emoji/CJK=2) lives in prose; deleting it regresses to trimming at the gate instead of writing to fit.",
      "source": {
        "file": "skills/ghostwriter-x/skills/ghostwriter-x/skill-invariants.json",
        "line": 1
      }
    },
