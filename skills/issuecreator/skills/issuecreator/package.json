{
  "name": "@natjswenson/issuecreator",
  "version": "0.1.0",
  "description": "Create actionable GitHub issues that issueflow can take through planning and implementation.",
  "license": "MIT",
  "author": "Nate Swenson",
  "homepage": "https://github.com/natejswenson/claude-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natejswenson/claude-skills.git"
  },
  "bugs": {
    "url": "https://github.com/natejswenson/claude-skills/issues"
  },
  "keywords": [
    "issuecreator",
    "claude-code",
    "claude-skill",
    "codex",
    "github-issues"
  ],
  "type": "module",
  "bin": {
    "issuecreator": "scripts/issuecreator.js"
  },
  "files": [
    "scripts/",
    "references/",
    "skill-invariants.json",
    "SKILL.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "evals/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs",
    "prepack": "cp ../../README.md ../../LICENSE ../../CHANGELOG.md .",
    "postpack": "rm -f README.md LICENSE CHANGELOG.md"
  }
}
